# Copy to .env and adjust as needed. Defaults here match docker-compose.yml.

# development, production or test. production turns off pretty logs.
NODE_ENV="development"
# HTTP port. Default: 3000.
PORT=3000

# After SIGTERM, /ready answers 503 for this many ms while the app still
# serves, then the server closes. Ctrl+C (SIGINT) skips the wait. Default:
# 5000, for production. 0 here because `start:dev` stops the app with SIGTERM
# on every rebuild, so each reload would wait the full drain.
SHUTDOWN_DRAIN_MS=0

DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb"
# Connections per app instance; keep replicas × DB_POOL_SIZE under the
# server's max_connections. Default: 10.
DB_POOL_SIZE=10

REDIS_URL="redis://localhost:6379"

# For AWS S3, leave S3_ENDPOINT unset (path-style URLs are used only with an
# endpoint) and S3_REGION unset to use AWS_REGION. Leave both keys unset to let
# the AWS SDK find credentials itself (AWS_* env vars, IRSA, container or
# instance role).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="rustfsadmin"
S3_SECRET_KEY="rustfsadmin"

OPENSEARCH_NODE="http://localhost:9200"
# Optional: basic auth (set both or neither), and the PEM text of the CA that
# signed the cluster certificate when a public CA did not. A one-line value may
# use \n for the line breaks.
# OPENSEARCH_USERNAME="admin"
# OPENSEARCH_PASSWORD="change-me"
# OPENSEARCH_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Pino log level: trace, debug, info, warn, error, fatal, silent. Default: info.
LOG_LEVEL="info"
# Optional: both go on every log line. APP_VERSION is what the deploy runs
# (a git SHA or an image tag; default: the package.json version). APP_ENV names
# the deployment, e.g. staging (default: NODE_ENV).
# APP_VERSION="abc1234"
# APP_ENV="staging"
