# Copy to .env and adjust as needed. Defaults here match docker-compose.yml.

DATABASE_URL="postgresql://johndoe:randompassword@localhost:5432/mydb"

REDIS_URL="redis://localhost:6379"

# For AWS S3, leave S3_ENDPOINT unset. Leave both keys unset to let the AWS SDK
# find credentials itself (AWS_* env vars, IRSA, container or instance role).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="rustfsadmin"
S3_SECRET_KEY="rustfsadmin"

OPENSEARCH_NODE="http://localhost:9200"
# Optional: basic auth (set both or neither), and the PEM text of the CA that
# signed the cluster certificate when a public CA did not.
# OPENSEARCH_USERNAME="admin"
# OPENSEARCH_PASSWORD="change-me"
# OPENSEARCH_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Pino log level: trace, debug, info, warn, error, fatal, silent. Default: info.
LOG_LEVEL="info"
# Optional: also write logs to rotating files (daily or 10 MB, keep 14), e.g. logs/app.
# The folder must hold only these logs. Leave unset to log to stdout only.
# LOG_FILE="logs/app"
