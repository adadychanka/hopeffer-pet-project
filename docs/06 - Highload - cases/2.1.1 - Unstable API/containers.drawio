<mxfile host="drawio">
  <diagram id="containers" name="Containers">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="Unstable external API — container diagram (C4, level 2)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="20" y="20" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Browser or mobile app" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" parent="1" vertex="1"><mxGeometry x="560" y="80" width="200" height="180" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;Our system&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Software System]&lt;/font&gt;" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=2;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;container=0;" parent="1" vertex="1"><mxGeometry x="40" y="300" width="1120" height="900" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;Backend API&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: NestJS]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Accepts the request, returns 202 + operationId in ~50 ms" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" parent="1" vertex="1"><mxGeometry x="80" y="360" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: PostgreSQL]&lt;/font&gt;&lt;br&gt;&lt;br&gt;operations (status, idempotencyKey) + outbox" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" parent="1" vertex="1"><mxGeometry x="520" y="360" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;Outbox Relay&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: Node.js]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Moves outbox records to the queue" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" parent="1" vertex="1"><mxGeometry x="880" y="360" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;Redis Cache&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: Redis]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Read responses from the API, stale-while-revalidate" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" parent="1" vertex="1"><mxGeometry x="80" y="660" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;Integration Worker&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: Node.js, ×N]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Timeouts, retries with backoff + jitter, circuit breaker, bulkhead" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" parent="1" vertex="1"><mxGeometry x="520" y="660" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;Job queue&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: BullMQ on Redis]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Jobs that call the external API" style="shape=cylinder3;size=15;direction=south;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" parent="1" vertex="1"><mxGeometry x="880" y="660" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b&gt;DLQ&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: BullMQ failed]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Jobs after all attempts" style="shape=cylinder3;size=15;direction=south;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" parent="1" vertex="1"><mxGeometry x="520" y="960" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b&gt;External API&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;Returns 500 at times, responds in 20–30 s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;" parent="1" vertex="1"><mxGeometry x="1240" y="660" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;b&gt;On-call engineer&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Alerts, manual DLQ triage" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" parent="1" vertex="1"><mxGeometry x="1260" y="940" width="200" height="180" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;b&gt;POST /orders → 202 + operationId;&lt;br&gt;GET /operations/:id&lt;/b&gt;&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="c2" target="c4" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c14" value="&lt;b&gt;1. INSERT operation + outbox,&lt;br&gt;one transaction&lt;/b&gt;&lt;br&gt;[SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="c4" target="c5" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c15" value="&lt;b&gt;2. Reads outbox&lt;/b&gt;&lt;br&gt;[SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="c6" target="c5" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c16" value="&lt;b&gt;3. Enqueues a job&lt;/b&gt;&lt;br&gt;[BullMQ]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="c6" target="c9" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c17" value="&lt;b&gt;4. Job&lt;/b&gt;&lt;br&gt;[BullMQ]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="c9" target="c8" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c18" value="&lt;b&gt;5. POST + Idempotency-Key,&lt;br&gt;connect 3 s, read 35 s&lt;/b&gt;&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0.5;entryY=1;" parent="1" source="c8" target="c11" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="880"/><mxPoint x="1360" y="880"/></Array></mxGeometry></mxCell>
        <mxCell id="c19" value="&lt;b&gt;6. Status done / failed&lt;/b&gt;&lt;br&gt;[SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="c8" target="c5" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c20" value="&lt;b&gt;After 8 attempts&lt;/b&gt;&lt;br&gt;[BullMQ]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="c8" target="c10" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c21" value="&lt;b&gt;Alert&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="c10" target="c12" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c22" value="&lt;b&gt;Reads&lt;/b&gt;&lt;br&gt;[Redis]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="c4" target="c7" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c23" value="&lt;b&gt;Background cache refresh&lt;/b&gt;&lt;br&gt;[Redis]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;dashed=1;" parent="1" source="c8" target="c7" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c24" value="&lt;b&gt;Result webhook, if available&lt;/b&gt;&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" parent="1" source="c11" target="c4" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c25" value="&lt;b&gt;Estimates (assumptions)&lt;/b&gt;&lt;br&gt;• Write (create an order at a partner), 50 RPS, API responds in 20–30 s&lt;br&gt;• Little&#x27;s law, synchronous: 50 × 25 s = 1,250 requests in flight — cannot hold user connections that long&lt;br&gt;&lt;br&gt;&lt;b&gt;Choice&lt;/b&gt;&lt;br&gt;Writes — queue and background processing (202 + status). Reads — cache + background refresh.&lt;br&gt;Cost: a queue, workers, operation statuses, eventual consistency, a &quot;processing&quot; UX.&lt;br&gt;&lt;br&gt;&lt;b&gt;Retries&lt;/b&gt;&lt;br&gt;• Timeout or 500 ≠ &quot;not done&quot; — retry only with the same Idempotency-Key&lt;br&gt;• No key — check the status by our reference id first&lt;br&gt;• Never retry 4xx — mark failed right away&lt;br&gt;&lt;br&gt;&lt;b&gt;Failure: API is down for an hour&lt;/b&gt;&lt;br&gt;• Circuit breaker opens, a probe request every 30 s&lt;br&gt;• The queue grows by 50 × 3,600 = 180,000 jobs, ~180 MB&lt;br&gt;• Bulkhead: a dedicated worker pool, the rest of the service keeps working&lt;br&gt;• After recovery — ramp up gradually within the API rate limit&lt;br&gt;&lt;br&gt;&lt;b&gt;What breaks first at ×10 (500 RPS)&lt;/b&gt;&lt;br&gt;1. The external API rate limit — negotiate, batch, cache&lt;br&gt;2. 12,500 concurrent calls: sockets, maxSockets, memory&lt;br&gt;3. An hour of downtime — 1.8M jobs, ~1.8 GB in Redis" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=11;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="1560" y="300" width="600" height="360" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
