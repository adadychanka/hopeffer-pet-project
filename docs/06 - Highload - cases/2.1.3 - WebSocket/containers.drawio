<mxfile host="drawio">
  <diagram id="containers" name="Containers">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2080" pageHeight="1260" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="Delivering events to 15,000 WebSocket clients — container diagram (C4, level 2)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="20" y="20" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;15,000 clients&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Browser or mobile app" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" parent="1" vertex="1"><mxGeometry x="560" y="80" width="200" height="180" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;Our system&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Software System]&lt;/font&gt;" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=2;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;container=0;" parent="1" vertex="1"><mxGeometry x="40" y="300" width="1200" height="880" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;Load balancer&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: AWS ALB / nginx]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Upgrade, least-connections, idle timeout &gt; ping" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" parent="1" vertex="1"><mxGeometry x="540" y="360" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;Instance 1&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: Node.js, Socket.IO]&lt;/font&gt;&lt;br&gt;&lt;br&gt;~5,000 WebSockets. Local connection table" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" parent="1" vertex="1"><mxGeometry x="160" y="620" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;Instance 2&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: Node.js, Socket.IO]&lt;/font&gt;&lt;br&gt;&lt;br&gt;~5,000 WebSockets" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" parent="1" vertex="1"><mxGeometry x="540" y="620" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;Instance 3&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: Node.js, Socket.IO]&lt;/font&gt;&lt;br&gt;&lt;br&gt;~5,000 WebSockets" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" parent="1" vertex="1"><mxGeometry x="920" y="620" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: PostgreSQL]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Source of truth, snapshot for GET /state" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" parent="1" vertex="1"><mxGeometry x="160" y="940" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;Redis Streams&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: Redis, Sentinel]&lt;/font&gt;&lt;br&gt;&lt;br&gt;events stream, MAXLEN ≈ 10 min — catch-up buffer" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" parent="1" vertex="1"><mxGeometry x="540" y="940" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b&gt;WebSocket; GET /state after&lt;br&gt;a long disconnect&lt;/b&gt;&lt;br&gt;[WSS / HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="c2" target="c4" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c11" value="&lt;b&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="c4" target="c5" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c12" value="&lt;b&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="c4" target="c6" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c13" value="&lt;b&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="c4" target="c7" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c14" value="&lt;b&gt;1. Persist the event&lt;/b&gt;&lt;br&gt;[SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="c5" target="c8" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c15" value="&lt;b&gt;2. XADD&lt;/b&gt;&lt;br&gt;[Redis]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0.25;entryY=0;" parent="1" source="c5" target="c9" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="340" y="850"/><mxPoint x="600" y="850"/></Array></mxGeometry></mxCell>
        <mxCell id="c16" value="&lt;b&gt;3. XREAD BLOCK&lt;/b&gt;&lt;br&gt;[Redis]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;entryX=0.75;entryY=1;" parent="1" source="c9" target="c6" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c17" value="&lt;b&gt;3. XREAD BLOCK&lt;/b&gt;&lt;br&gt;[Redis]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" parent="1" source="c9" target="c7" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1040" y="1005"/></Array></mxGeometry></mxCell>
        <mxCell id="c18" value="&lt;b&gt;Estimates (assumptions)&lt;/b&gt;&lt;br&gt;• One event for all clients, up to 10 events/s, no loss allowed&lt;br&gt;• 15,000 / 3 = ~5,000 connections per instance&lt;br&gt;• Fan-out: 10 × 15,000 = 150,000 sends/s&lt;br&gt;• Memory: 20–50 KB per connection → up to ~750 MB per cluster&lt;br&gt;&lt;br&gt;&lt;b&gt;Options and their cost&lt;/b&gt;&lt;br&gt;• Redis Pub/Sub: simple. Cost — at-most-once, no history for catch-up&lt;br&gt;• Redis Streams (chosen): the stream is a catch-up buffer by lastEventId. Cost — MAXLEN tuning, more complex&lt;br&gt;• Managed (API Gateway, Centrifugo, Ably): cost — money, vendor lock-in&lt;br&gt;&lt;br&gt;&lt;b&gt;Deploy&lt;/b&gt;&lt;br&gt;SIGTERM → readiness 503 → httpServer.close() → close 500 connections every 5 s (code 1001). Client — backoff + jitter. terminationGracePeriodSeconds and deregistration_delay longer than the drain window.&lt;br&gt;&lt;br&gt;&lt;b&gt;After reconnect&lt;/b&gt;&lt;br&gt;• Subscribe to live first, then catch up from the stream, dedup by id&lt;br&gt;• Gap longer than the buffer — snapshot via GET /state&lt;br&gt;• Subscriptions (rooms) lived in the old instance&#x27;s memory — restore them&lt;br&gt;&lt;br&gt;&lt;b&gt;Failures&lt;/b&gt;&lt;br&gt;• Redis down — no cross-instance delivery or catch-up. Sentinel / Multi-AZ, then snapshot&lt;br&gt;• Slow client — cap bufferedAmount, otherwise instance memory grows&lt;br&gt;• Instance died without close — the client notices via heartbeat (~45 s)&lt;br&gt;&lt;br&gt;&lt;b&gt;What breaks first at ×10 (150,000)&lt;/b&gt;&lt;br&gt;1. CPU on fan-out: 1.5M sends/s — batching, send only changes&lt;br&gt;2. Memory ~7.5 GB, ulimit -n, load balancer limits&lt;br&gt;3. Thundering herd on deploy" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=11;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="1300" y="300" width="740" height="440" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
