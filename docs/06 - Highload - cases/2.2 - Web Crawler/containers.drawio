                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="572" y="490" />
                            <mxPoint x="1160" y="490" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="containers-22" value="&lt;b&gt;Resolves domains&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" parent="1" source="containers-10" target="containers-6" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="containers-23" value="&lt;b&gt;GET: connect 3 s, total 10 s&lt;/b&gt;&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="containers-10" target="containers-4" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="containers-24" value="&lt;b&gt;Stores robots.txt&lt;/b&gt;&lt;br&gt;[Redis]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="containers-10" target="containers-11" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="containers-25" value="&lt;b&gt;Writes HTML (gzip)&lt;/b&gt;&lt;br&gt;[S3 API]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="containers-10" target="containers-12" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="containers-26" value="&lt;b&gt;page-fetched event&lt;/b&gt;&lt;br&gt;[Kafka]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="containers-10" target="containers-13" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="860" y="644" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="containers-27" value="&lt;b&gt;Reads events&lt;/b&gt;&lt;br&gt;[consumer group]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="containers-13" target="containers-16" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="containers-28" value="&lt;b&gt;Reads HTML&lt;/b&gt;&lt;br&gt;[S3 API]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="containers-16" target="containers-12" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="680" y="1052" />
                            <mxPoint x="680" y="845" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="containers-29" value="&lt;b&gt;URL Seen? / Content Seen?&lt;/b&gt;&lt;br&gt;[Redis]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" parent="1" source="containers-16" target="containers-15" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="containers-30" value="&lt;b&gt;Status, hash, s3Key&lt;/b&gt;&lt;br&gt;[CQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" source="containers-16" target="containers-14" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1220" y="1052" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="containers-31" value="&lt;b&gt;New URLs in batches&lt;/b&gt;&lt;br&gt;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" parent="1" source="containers-16" target="containers-8" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1400" y="1117" />
                            <mxPoint x="1400" y="490" />
                            <mxPoint x="1304" y="490" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="containers-32" value="&lt;b&gt;Read pages&lt;/b&gt;&lt;br&gt;[S3 API]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="containers-5" target="containers-12" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="containers-33" value="&lt;b&gt;Estimates (assumptions)&lt;/b&gt;&lt;br&gt;• 1B pages per month → ~400 pages/s, peak ~800&lt;br&gt;• Average HTML 500 KB (as in the chapter) → 500 TB/month raw, ~100 TB gzipped&lt;br&gt;• Network: 400 × 500 KB = 200 MB/s ≈ 1.6 Gbit/s&lt;br&gt;• Little's law: 400 pages/s × 2 s = ~800 concurrent fetches&lt;br&gt;• Bloom filter for 1B URLs at 1% false positives ≈ 1.2 GB&lt;br&gt;• Metadata: 1B × ~200 B ≈ 200 GB&lt;br&gt;&lt;br&gt;&lt;b&gt;Queue partition key&lt;/b&gt;&lt;br&gt;hash(host) via consistent hashing: all URLs of a host live in one Frontier shard → politeness is enforced locally, no distributed locks. Cost: a hot host sits entirely in one shard; a new shard moves ~1/N of hosts.&lt;br&gt;&lt;br&gt;&lt;b&gt;Duplicates and traps&lt;/b&gt;&lt;br&gt;• Normalize URLs before any check&lt;br&gt;• URL Seen? — Bloom: a false &quot;seen&quot; skips a few new URLs but never downloads twice&lt;br&gt;• Content Seen? — sha256 of content: the same page under different URLs&lt;br&gt;• URL length ≤ 2048, depth ≤ 15, daily page limit per host&lt;br&gt;&lt;br&gt;&lt;b&gt;Politeness&lt;/b&gt;&lt;br&gt;robots.txt (24 h cache, crawl-delay); 1 request per host at a time + pause; the pause grows on 429/503 and rising latency; User-Agent with contact info.&lt;br&gt;&lt;br&gt;&lt;b&gt;Failure: a site takes 30 s to respond&lt;/b&gt;&lt;br&gt;Connect 3 s, total 10 s → abort, nack(timeout). Frontier doubles the host pause; after 3 timeouts in a row the host is paused for an hour. Fetches are async: a slow host holds 1 slot out of ~200, the rest keep downloading.&lt;br&gt;&lt;br&gt;&lt;b&gt;Failure: a worker dies mid-download&lt;/b&gt;&lt;br&gt;The URL is leased for 60 s. No ack → Lease Reaper returns it to the host queue, attempts+1, after 3 — dead. S3 PUT is atomic: a partial file never appears. The Kafka event is published only after the S3 write. A retry is safe: the S3 key is deterministic, Content Seen? drops the duplicate.&lt;br&gt;&lt;br&gt;&lt;b&gt;What breaks first at ×10 (4,000 pages/s)&lt;/b&gt;&lt;br&gt;1. Network (~16 Gbit/s) and storage (~5 PB/month raw) → gzip, store only changed pages.&lt;br&gt;2. Frontier Store memory: hundreds of millions of URLs in Redis → cold URLs to disk, Redis only as a buffer.&lt;br&gt;3. Politeness: a single host cannot go 10× faster — you need wider host coverage." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=11;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="1820" y="240" width="620" height="980" as="geometry" />
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>