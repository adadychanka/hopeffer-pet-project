                <mxCell id="containers-2" value="&lt;b&gt;Web Crawler&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Software System]&lt;/font&gt;" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=2;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;container=0;" parent="1" vertex="1">
                    <mxGeometry x="340" y="240" width="1420" height="980" as="geometry" />
                </mxCell>
                <mxCell id="containers-3" value="&lt;b&gt;Crawler operator&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Sets seed URLs and the blocklist, watches metrics" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" parent="1" vertex="1">
                    <mxGeometry x="760" y="20" width="200" height="180" as="geometry" />
                </mxCell>
                <mxCell id="containers-4" value="&lt;b&gt;Websites&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Third-party sites: HTML and robots.txt&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;" parent="1" vertex="1">
                    <mxGeometry x="20" y="540" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="containers-5" value="&lt;b&gt;Data consumers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Search index, analytics&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;" parent="1" vertex="1">
                    <mxGeometry x="20" y="780" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="containers-6" value="&lt;b&gt;DNS Cache&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Unbound]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Local DNS cache: lookup 10–200 ms → ~0 ms&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" parent="1" vertex="1">
                    <mxGeometry x="380" y="300" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="containers-7" value="&lt;b&gt;Admin API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: NestJS]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Seed URLs, blocklist, per-host limits&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" parent="1" vertex="1">
                    <mxGeometry x="740" y="300" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="containers-8" value="&lt;b&gt;URL Frontier Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Node.js, N shards]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Priority (front queues) and politeness (back queues: 1 host = 1 queue). Leases URLs out&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="300" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="containers-9" value="&lt;b&gt;Frontier Store&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Redis Cluster]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;URL queues, host heap by nextFetchAt, leases. Shard = hash(host)&lt;/font&gt;" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" parent="1" vertex="1">
                    <mxGeometry x="1460" y="300" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="containers-10" value="&lt;b&gt;Fetcher Workers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Node.js, undici, ×N]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Download pages asynchronously: up to 200 fetches per worker, 1 per host&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" parent="1" vertex="1">
                    <mxGeometry x="380" y="540" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="containers-11" value="&lt;b&gt;Robots &amp; Politeness Cache&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Redis]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;robots.txt (TTL 24 h), crawl-delay, host pause and health&lt;/font&gt;" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="540" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="containers-12" value="&lt;b&gt;Page Storage&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: S3]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Raw HTML, gzipped. Key = sha256(url)/crawlTs&lt;/font&gt;" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" parent="1" vertex="1">
                    <mxGeometry x="380" y="780" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="containers-13" value="&lt;b&gt;page-fetched&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Kafka topic]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Fetch events: url, s3Key, status&lt;/font&gt;" style="shape=cylinder3;size=15;direction=south;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" parent="1" vertex="1">
                    <mxGeometry x="740" y="780" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="containers-14" value="&lt;b&gt;URL Metadata DB&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Cassandra]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;URL status, crawl time, content hash, s3Key. Partition = host&lt;/font&gt;" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" parent="1" vertex="1">
                    <mxGeometry x="1100" y="780" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="containers-15" value="&lt;b&gt;Dedup Store&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Redis + RedisBloom]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;URL Seen? — Bloom filter. Content Seen? — content hashes&lt;/font&gt;" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" parent="1" vertex="1">
                    <mxGeometry x="380" y="1020" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="containers-16" value="&lt;b&gt;Parser Workers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Node.js, cheerio, ×N]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Validate HTML, drop duplicate content, extract and filter links&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" parent="1" vertex="1">
