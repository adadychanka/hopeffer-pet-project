                <mxCell id="parser-28" value="&lt;b&gt;New URLs&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="parser-15" target="parser-16" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="parser-29" value="&lt;b&gt;BF.EXISTS / BF.ADD&lt;/b&gt;&lt;br&gt;[RedisBloom]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" parent="1" source="parser-15" target="parser-7" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="460" y="900" />
                            <mxPoint x="1120" y="900" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="parser-30" value="&lt;b&gt;URL batches&lt;/b&gt;&lt;br&gt;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="parser-16" target="parser-6" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="parser-31" value="&lt;b&gt;How not to download twice or loop forever&lt;/b&gt;&lt;br&gt;• Normalization: one page — one URL.&lt;br&gt;• URL Seen? — Bloom filter: &quot;no&quot; is exact, &quot;yes&quot; is wrong ~1% of the time. We lose a few new URLs but never download twice.&lt;br&gt;• Content Seen?: ~30% of web pages are duplicates under different URLs.&lt;br&gt;• Traps: URL length &gt; 2048, depth &gt; 15, &gt; 10,000 pages per host per day, repeated path segments (/a/b/a/b/).&lt;br&gt;• The Kafka offset is committed after processing: on a crash the event comes again, dedup makes the retry safe." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=11;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="1760" y="220" width="440" height="380" as="geometry" />
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>