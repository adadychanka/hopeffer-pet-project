                <mxCell id="fetcher-3" value="&lt;b&gt;URL Frontier Service&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Node.js]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;URL leases&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" parent="1" vertex="1">
