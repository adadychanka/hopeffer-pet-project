                <mxCell id="frontier-5" value="&lt;b&gt;Fetcher Workers&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Node.js]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Download pages&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" parent="1" vertex="1">
                    <mxGeometry x="20" y="480" width="220" height="120" as="geometry" />
                </mxCell>
                <mxCell id="frontier-6" value="&lt;b&gt;Frontier Store&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Redis Cluster]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Queues, host heap, leases&lt;/font&gt;" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" parent="1" vertex="1">
                    <mxGeometry x="700" y="960" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="frontier-7" value="&lt;b&gt;Robots &amp; Politeness Cache&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Redis]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;robots.txt, crawl-delay&lt;/font&gt;" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="960" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="frontier-8" value="&lt;b&gt;Enqueue API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component: gRPC controller]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Accepts new URLs in batches&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;" parent="1" vertex="1">
                    <mxGeometry x="340" y="260" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="frontier-9" value="&lt;b&gt;Prioritizer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component: TS module]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Scores priority: PageRank signal, update frequency, depth&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;" parent="1" vertex="1">
                    <mxGeometry x="700" y="260" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="frontier-10" value="&lt;b&gt;Front Queues f1…fn&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component: Redis lists]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;One queue per priority level&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="260" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="frontier-11" value="&lt;b&gt;Front Queue Selector&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component: TS module]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Weighted random pick: higher priority — more often&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="480" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="frontier-12" value="&lt;b&gt;Back Queue Router + Mapping&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component: TS module]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;host → back queue table. One back queue holds exactly one host&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;" parent="1" vertex="1">
                    <mxGeometry x="700" y="480" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="frontier-13" value="&lt;b&gt;Lease API&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component: gRPC controller]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Leases URL batches for 60 s; ack/nack&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;" parent="1" vertex="1">
                    <mxGeometry x="340" y="480" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="frontier-14" value="&lt;b&gt;Politeness Scheduler&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component: TS module]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Host heap by nextFetchAt. Crawl-delay; the pause grows on 429/503 and timeouts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;" parent="1" vertex="1">
                    <mxGeometry x="700" y="700" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="frontier-15" value="&lt;b&gt;Lease Reaper&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component: cron, every 10 s]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Returns expired leases to the host queue, attempts+1, after 3 — dead&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;" parent="1" vertex="1">
                    <mxGeometry x="340" y="700" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="frontier-16" value="&lt;b&gt;Seed URLs&lt;/b&gt;&lt;br&gt;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="frontier-3" target="frontier-8" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="frontier-17" value="&lt;b&gt;New URLs&lt;/b&gt;&lt;br&gt;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="frontier-4" target="frontier-8" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="frontier-18" value="&lt;b&gt;lease / ack / nack&lt;/b&gt;&lt;br&gt;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="frontier-5" target="frontier-13" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="frontier-19" value="&lt;b&gt;URL&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="frontier-8" target="frontier-9" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="frontier-20" value="&lt;b&gt;URL + priority&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="frontier-9" target="frontier-10" edge="1">
                    <mxGeometry relative="1" as="geometry" />
