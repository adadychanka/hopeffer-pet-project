                <mxCell id="fetcher-4" value="&lt;b&gt;Robots &amp; Politeness Cache&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Redis]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;robots.txt&lt;/font&gt;" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" parent="1" vertex="1">
                    <mxGeometry x="1400" y="260" width="220" height="120" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-5" value="&lt;b&gt;DNS Cache&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Unbound]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Shared DNS cache&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" parent="1" vertex="1">
                    <mxGeometry x="1400" y="480" width="220" height="120" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-6" value="&lt;b&gt;Websites&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;HTML&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;" parent="1" vertex="1">
                    <mxGeometry x="1400" y="700" width="220" height="120" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-7" value="&lt;b&gt;page-fetched&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: Kafka topic]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Fetch events&lt;/font&gt;" style="shape=cylinder3;size=15;direction=south;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" parent="1" vertex="1">
                    <mxGeometry x="340" y="960" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-8" value="&lt;b&gt;Page Storage&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Container: S3]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Gzipped HTML&lt;/font&gt;" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" parent="1" vertex="1">
                    <mxGeometry x="700" y="960" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-9" value="&lt;b&gt;Lease Client&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component: gRPC client]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Takes a URL batch, extends the lease, sends ack/nack&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;" parent="1" vertex="1">
                    <mxGeometry x="340" y="260" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-10" value="&lt;b&gt;Fetch Orchestrator&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component: TS module]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Up to 200 parallel fetches, at most 1 per host&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;" parent="1" vertex="1">
                    <mxGeometry x="700" y="260" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-11" value="&lt;b&gt;Robots Checker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component: TS module]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Checks Disallow against the robots.txt cache&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="260" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-12" value="&lt;b&gt;Error Classifier&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component: TS module]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Timeout, 5xx, 429 → nack with reason. 4xx → failed, no retry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;" parent="1" vertex="1">
                    <mxGeometry x="340" y="480" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-13" value="&lt;b&gt;HTTP Downloader&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component: undici]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Connect 3 s, total 10 s, max 2 MB, ≤ 5 redirects&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;" parent="1" vertex="1">
                    <mxGeometry x="700" y="480" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-14" value="&lt;b&gt;DNS Client&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component: TS module]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Local cache honoring record TTL + shared DNS Cache&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="480" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-15" value="&lt;b&gt;Event Publisher&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component: Kafka producer]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;Publishes page-fetched only after the S3 write, then acks&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;" parent="1" vertex="1">
                    <mxGeometry x="340" y="700" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-16" value="&lt;b&gt;Page Writer&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;[Component: S3 SDK]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;gzip, key = sha256(url)/crawlTs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#ffffff;align=center;arcSize=6;strokeColor=#2086C9;" parent="1" vertex="1">
                    <mxGeometry x="700" y="700" width="240" height="130" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-17" value="&lt;b&gt;lease / ack / nack&lt;/b&gt;&lt;br&gt;[gRPC]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="fetcher-9" target="fetcher-3" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-18" value="&lt;b&gt;URL batch&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="fetcher-9" target="fetcher-10" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-19" value="&lt;b&gt;Allowed to fetch?&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="fetcher-10" target="fetcher-11" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-20" value="&lt;b&gt;Rules&lt;/b&gt;&lt;br&gt;[Redis]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="fetcher-11" target="fetcher-4" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-21" value="&lt;b&gt;Fetch&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="fetcher-10" target="fetcher-13" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-22" value="&lt;b&gt;Host IP&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="fetcher-13" target="fetcher-14" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-23" value="&lt;b&gt;DNS&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="fetcher-14" target="fetcher-5" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-24" value="&lt;b&gt;GET&lt;/b&gt;&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="fetcher-13" target="fetcher-6" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="880" y="650" />
                            <mxPoint x="1360" y="650" />
                            <mxPoint x="1360" y="760" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="fetcher-25" value="&lt;b&gt;Timeout, 5xx, 429&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="fetcher-13" target="fetcher-12" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-26" value="&lt;b&gt;nack + reason&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="fetcher-12" target="fetcher-9" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-27" value="&lt;b&gt;200 OK&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="fetcher-13" target="fetcher-16" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-28" value="&lt;b&gt;PUT&lt;/b&gt;&lt;br&gt;[S3 API]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="fetcher-16" target="fetcher-8" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-29" value="&lt;b&gt;Stored&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="fetcher-16" target="fetcher-15" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-30" value="&lt;b&gt;page-fetched&lt;/b&gt;&lt;br&gt;[Kafka]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="fetcher-15" target="fetcher-7" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="fetcher-31" value="&lt;b&gt;Failures&lt;/b&gt;&lt;br&gt;• Site takes 30 s: abort at 10 s, nack(timeout), Frontier doubles the host pause. A slow host takes 1 slot out of ~200.&lt;br&gt;• Worker died: the 60 s lease expires, the URL returns to the queue. S3 PUT is atomic, the event is sent only after the write." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=11;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="1060" y="960" width="560" height="200" as="geometry" />
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
