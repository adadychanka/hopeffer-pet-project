                <mxCell id="frontier-21" value="&lt;b&gt;Queues&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="frontier-10" target="frontier-11" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="frontier-22" value="&lt;b&gt;Next URL&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="frontier-11" target="frontier-12" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="frontier-23" value="&lt;b&gt;URL to host queue&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="frontier-12" target="frontier-14" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="frontier-24" value="&lt;b&gt;Ready hosts; ack/nack → nextFetchAt&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" parent="1" source="frontier-13" target="frontier-14" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="460" y="650" />
                            <mxPoint x="760" y="650" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="frontier-25" value="&lt;b&gt;Return URL to queue&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="frontier-15" target="frontier-14" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="frontier-26" value="&lt;b&gt;Heap, back queues, leases&lt;/b&gt;&lt;br&gt;[Redis]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="frontier-14" target="frontier-6" edge="1">
                    <mxGeometry relative="1" as="geometry" />
                </mxCell>
                <mxCell id="frontier-27" value="&lt;b&gt;Finds expired leases&lt;/b&gt;&lt;br&gt;[Redis]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="frontier-15" target="frontier-6" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="460" y="1025" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="frontier-28" value="&lt;b&gt;Crawl-delay, Disallow&lt;/b&gt;&lt;br&gt;[Redis]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="frontier-14" target="frontier-7" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1180" y="765" />
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="frontier-29" value="&lt;b&gt;How to read&lt;/b&gt;&lt;br&gt;• Front queues — priority: important pages first.&lt;br&gt;• Back queues — politeness: one host = one queue = at most one request at a time.&lt;br&gt;• The Frontier shard is picked by hash(host): politeness is enforced locally, no distributed locks.&lt;br&gt;• Lease with a timeout: if a worker dies, the URL returns to the queue on its own." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=11;fontColor=#333333;" parent="1" vertex="1">
                    <mxGeometry x="1400" y="220" width="460" height="300" as="geometry" />
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
