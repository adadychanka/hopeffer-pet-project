<mxfile host="drawio">
  <diagram id="containers" name="Containers">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2160" pageHeight="1460" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c1" value="RabbitMQ: reliable message processing — container diagram (C4, level 2)" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="20" y="20" width="900" height="40" as="geometry"/></mxCell>
        <mxCell id="c2" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Places an order" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" parent="1" vertex="1"><mxGeometry x="60" y="80" width="200" height="180" as="geometry"/></mxCell>
        <mxCell id="c3" value="&lt;b&gt;Producer service&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Software System]&lt;/font&gt;" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=2;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;container=0;" parent="1" vertex="1"><mxGeometry x="40" y="300" width="320" height="700" as="geometry"/></mxCell>
        <mxCell id="c4" value="&lt;b&gt;Backend API&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: NestJS]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Creates the order" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" parent="1" vertex="1"><mxGeometry x="80" y="360" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c5" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: PostgreSQL]&lt;/font&gt;&lt;br&gt;&lt;br&gt;orders + outbox" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" parent="1" vertex="1"><mxGeometry x="80" y="580" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b&gt;Outbox Relay&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: Node.js]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Publishes outbox with publisher confirms, sets sent_at" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" parent="1" vertex="1"><mxGeometry x="80" y="800" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b&gt;RabbitMQ, 3 nodes&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: RabbitMQ 4.x]&lt;/font&gt;" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=2;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;container=0;" parent="1" vertex="1"><mxGeometry x="420" y="520" width="640" height="680" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b&gt;orders.retry&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: classic queue]&lt;/font&gt;&lt;br&gt;&lt;br&gt;TTL 1 s → 10 s → 1 min, then back to orders" style="shape=cylinder3;size=15;direction=south;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" parent="1" vertex="1"><mxGeometry x="780" y="580" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b&gt;Exchange&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: direct exchange]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Routes by routing key" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" parent="1" vertex="1"><mxGeometry x="460" y="800" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b&gt;orders&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: quorum queue]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Replicas on 3 nodes, x-delivery-limit" style="shape=cylinder3;size=15;direction=south;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" parent="1" vertex="1"><mxGeometry x="780" y="800" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b&gt;orders.dlq&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: quorum queue]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Messages that could not be processed" style="shape=cylinder3;size=15;direction=south;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" parent="1" vertex="1"><mxGeometry x="460" y="1020" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;b&gt;DLX&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: dead letter exchange]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Receives rejected messages" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" parent="1" vertex="1"><mxGeometry x="780" y="1020" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;b&gt;Consumer service&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Software System]&lt;/font&gt;" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=2;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;spacing=10;dashPattern=8 4;container=0;" parent="1" vertex="1"><mxGeometry x="1120" y="520" width="320" height="460" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: PostgreSQL]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Data + processed_messages (message_id PK)" style="shape=cylinder3;size=15;whiteSpace=wrap;html=1;boundedLbl=1;rounded=0;labelBackgroundColor=none;fillColor=#23A2D9;fontSize=11;fontColor=#ffffff;align=center;strokeColor=#0E7DAD;" parent="1" vertex="1"><mxGeometry x="1160" y="580" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;b&gt;Consumer&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Container: Node.js, ×N]&lt;/font&gt;&lt;br&gt;&lt;br&gt;Manual ack, prefetch 10, try/catch with explicit nack" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" parent="1" vertex="1"><mxGeometry x="1160" y="800" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;b&gt;On-call engineer&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:10px&#x27;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;DLQ alert, manual replay after a fix" style="html=1;fontSize=11;dashed=0;whiteSpace=wrap;fillColor=#083F75;strokeColor=#06315C;fontColor=#ffffff;shape=mxgraph.c4.person2;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;" parent="1" vertex="1"><mxGeometry x="470" y="1240" width="200" height="180" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;b&gt;Place order&lt;/b&gt;&lt;br&gt;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="c2" target="c4" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c18" value="&lt;b&gt;1. INSERT order + outbox,&lt;br&gt;one transaction&lt;/b&gt;&lt;br&gt;[SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="c4" target="c5" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c19" value="&lt;b&gt;2. Reads outbox&lt;/b&gt;&lt;br&gt;[SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="c6" target="c5" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c20" value="&lt;b&gt;3. publish persistent&lt;br&gt;+ publisher confirms&lt;/b&gt;&lt;br&gt;[AMQP]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="c6" target="c9" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c21" value="&lt;b&gt;routing key&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="c9" target="c10" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c22" value="&lt;b&gt;4. Delivery&lt;br&gt;6. ack after&lt;br&gt;commit&lt;/b&gt;&lt;br&gt;[AMQP]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;startArrow=blockThin;startFill=1;" parent="1" source="c10" target="c15" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c23" value="&lt;b&gt;5. Data + message_id,&lt;br&gt;one transaction&lt;/b&gt;&lt;br&gt;[SQL]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="c15" target="c14" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c24" value="&lt;b&gt;nack: transient error&lt;/b&gt;&lt;br&gt;[AMQP]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;exitX=0;exitY=0.25;" parent="1" source="c15" target="c8" edge="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="832"/><mxPoint x="1090" y="645"/></Array></mxGeometry></mxCell>
        <mxCell id="c25" value="&lt;b&gt;After TTL&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;dashed=1;" parent="1" source="c8" target="c10" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c26" value="&lt;b&gt;Permanent error&lt;br&gt;or attempt limit&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="c10" target="c12" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c27" value="&lt;b&gt;&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="c12" target="c11" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c28" value="&lt;b&gt;Alert&lt;/b&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=blockThin;endFill=1;strokeColor=#828282;fontSize=10;fontColor=#404040;labelBackgroundColor=#ffffff;" parent="1" source="c11" target="c16" edge="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c29" value="&lt;b&gt;Consumer crashed before the DB write&lt;/b&gt;&lt;br&gt;• Auto-ack — the message is lost&lt;br&gt;• Manual ack after commit — it goes back to the queue (redelivered), nothing is lost&lt;br&gt;• Crashed after commit, before ack — a duplicate. Hence idempotency: message_id in processed_messages in the same transaction&lt;br&gt;&lt;br&gt;&lt;b&gt;Exception without ack/nack&lt;/b&gt;&lt;br&gt;The message stays unacked while the channel lives. 10 of them (prefetch) — the consumer stalls. consumer_timeout is 30 min. So always nack explicitly in catch.&lt;br&gt;&lt;br&gt;&lt;b&gt;Poison message&lt;/b&gt;&lt;br&gt;Transient error — retry queue with TTL. Permanent error or x-delivery-limit (20 in 4.x) — DLX → DLQ, alert.&lt;br&gt;&lt;br&gt;&lt;b&gt;Options and their cost&lt;/b&gt;&lt;br&gt;• Ack before processing: simple, fast. Cost — loss on crash&lt;br&gt;• Ack after commit + idempotency: no loss. Cost — inbox table, dedup&lt;br&gt;• Quorum instead of classic: survives a node failure. Cost — disk, network, lower throughput&lt;br&gt;• Outbox on the producer: no loss between DB and publish. Cost — a table, a relay, latency&lt;br&gt;&lt;br&gt;&lt;b&gt;What breaks first at ×10&lt;/b&gt;&lt;br&gt;1. processed_messages grows — TTL cleanup, partition by date&lt;br&gt;2. Prefetch: large — a burst of redeliveries on crash, small — lower throughput&lt;br&gt;3. Consumer DB down — messages burn through the limit and land in the DLQ: add backoff or a circuit breaker" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFF9E6;strokeColor=#D6B656;fontSize=11;fontColor=#333333;" parent="1" vertex="1"><mxGeometry x="1500" y="300" width="620" height="380" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
